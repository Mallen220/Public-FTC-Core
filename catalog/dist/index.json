        },
        {
          "coordinate": "dev.frozenmilk:Sinister",
          "reason": "Remove Sinister; Dairy Core includes Sloth instead (see the Sloth README)."
        },
        {
          "coordinate": "com.acmerobotics.dashboard:dashboard",
          "reason": "The standard FTC Dashboard does not work with Sloth; use the Sloth-compatible FTC Dashboard (slothboard)."
        }
      ],
      "verification": {
        "sources": [
