      "knownIssues": [
        {
          "id": "tuning-1-0-2-tuner-scanner-crash",
          "severity": "error",
          "coordinate": "com.pedropathing:tuning",
          "versions": [
            "1.0.2"
          ],
          "sourceContains": "@Tuner",
          "summary": "AutoTune crashes while TeamCode loads: the robot stops after a Sloth hot reload and AutoTune lists no procedures.",
          "details": "TunerScanner in com.pedropathing:tuning 1.0.2 calls Map.putIfAbsent(...).add(...), which throws a NullPointerException the first time it scans a class with @Tuner methods (usually Tuning.java). The tuning library always brings in the Sloth runtime, which treats this as a fatal loading error: loading TeamCode fails when the app starts, and after a hot reload the robot stops with \"User code threw an uncaught exception\". Versions 1.0.0 and 1.0.1 do not have this code; 1.0.3-beta.1 fixes it. The Pedro Pathing Quickstart uses 1.0.1.",
          "fixVersion": "1.0.1",
          "fixedIn": "1.0.3-beta.1",
          "logSignature": "TunerScanner.scan(TunerScanner.java:59)",
          "url": "https://github.com/Pedro-Pathing/Quickstart/blob/master/build.dependencies.gradle"
        }
      ],
      "upgradeNotes": [
        {
          "fromVersion": "2.x",
          "toVersion": "3.0.0",
          "text": "Pedro Pathing 3 replaces com.pedropathing:ftc with com.pedropathing:revhub. SolversLib 0.3.6 or newer is required for its Pedro Pathing module.",
          "url": "https://pedropathing.com/docs/pathing/installation"
        }
      ],
