        }
      ],
      "artifacts": [
        {
          "coordinate": "dev.frozenmilk.sinister:Sloth",
          "role": "primary",
          "description": "Sloth runtime, installed with the Robot Controller app"
        },
        {
          "coordinate": "dev.frozenmilk:Load",
          "role": "plugin-classpath",
          "description": "Gradle plugin that adds the deploySloth and removeSlothRemote tasks"
        }
      ],
      "versions": [
        {
          "version": "0.3.2",
          "released": "2026-09-17",
          "artifacts": {
            "dev.frozenmilk.sinister:Sloth": "0.3.2",
            "dev.frozenmilk:Load": "0.3.2"
          }
        },
        {
          "version": "0.2.4",
          "artifacts": {
            "dev.frozenmilk.sinister:Sloth": "0.2.4",
            "dev.frozenmilk:Load": "0.2.4"
          }
        }
      ],
      "install": {
        "target": "teamcode",
        "gradlePlugins": [
          {
            "id": "dev.frozenmilk.sinister.sloth.load",
            "classpathCoordinate": "dev.frozenmilk:Load"
          }
        ],
        "tasks": [
          "deploySloth",
          "removeSlothRemote"
        ],
        "postInstall": [
          "Do one full install (FTC: Full Install) before the first hot reload; FTC Core enforces this.",
          "Only classes in org.firstinspires.ftc.teamcode and its subpackages are hot reloaded. Changes to libraries, resources or @Pinned classes need a full install; FTC Core detects these and switches automatically."
        ]
      },
      "sloth": {
        "compatibility": "compatible"
      },
      "conflicts": [
